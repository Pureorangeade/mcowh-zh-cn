{
  "message/data/event/object/udb22_229_fighting_dog_before_ev_talk.txt/4": "驯服了兽人佣兵！",
  "message/data/event/object/udb22_229_fighting_dog_before_ev_talk.txt/5": "汪，汪……",
  "message/data/event/object/udb22_229_fighting_dog_before_ev_talk.txt/6": "汪，汪汪，汪汪！\r\n呜噜……走开！",
  "message/data/event/object/udb22_229_fighting_dog_before_ev_talk.txt/7": "给了肉，但它警惕得不肯吃。\r\n看来是你的魅力不够。",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_damage.txt/0": "呜嘤……！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_damage.txt/1": "汪，汪汪！\r\n好痛啊，汪呜！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_damage.txt/2": "呜噜噜！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_darkness.txt/0": "嗷呜——！！！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_find.txt/0": "汪汪汪，别丢下我汪！\r\n呜嘤……",
  "choice/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/142": "\\c[4]给予疗伤草_\\c[52]剩余$tmp2_remaining\\c[2][浪费]",
  "choice/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/262": "\\c[4]给予疗伤膏_\\c[52]剩余$tmp2_remaining\\c[2][浪费]",
  "choice/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/429": "给予疗伤草_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/540": "\\c[4]给予疗伤草_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/690": "给予疗伤膏_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/802": "\\c[4]给予疗伤膏_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/913": "你还好吗？",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/0": "看来现在不需要治疗。",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/1": "你没有任何治疗物品！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/2": "汪，汪汪！\r\n嗷呜——！！\r\n你看，我精神着呢汪！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/3": "汪，汪……\r\n只是有一点点累，汪。",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/4": "汪，汪汪……\r\n伤口好痛，汪……",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/5": "汪，呜嘤……\r\n呜——……",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/6": "嘎吱嘎吱嘎吱……\r\n汪，汪汪！好难吃！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/7": "<TARGET>的HP\r\n恢复了50%！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/8": "舔舔舔舔……\r\n汪，汪汪！好难喝！\r\n不过感觉好多了！",
  "message/data/event/object/udb22_230_fighting_dog_after_ev_talk.txt/9": "<TARGET>的HP\r\n已完全恢复！",
  "choice/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/113": "雇佣_\\c[52]$tmp3拉比斯\\c[0]（CHR_\\c[52]$tmp1\\c[0]→\\c[2]$tmp2_Insuff.\\c[0]）",
  "choice/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/240": "雇佣_\\c[52]$tmp3拉比斯\\c[0]（CHR_\\c[52]$tmp1\\c[0]→\\c[3]$tmp2\\c[0]）",
  "choice/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/337": "雇佣_\\c[52]$tmp3拉比斯\\c[0]（CHR_\\c[52]$tmp1\\c[0]→\\c[3]$tmp2\\c[0]）",
  "choice/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/442": "不用了。",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/0": "你，旅人！\r\n我，佣兵！\r\n我，能帮你！",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/1": "给我$tmp3拉比斯，我，你，同伴！\r\n我，跟在你后面。\r\n我，山、河，走不了。\r\n\\c[52][协力NPC，需要魅力等级1]",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/2": "钱，不够。\r\n我，明白。\r\n你，骗佣兵，不行。",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/3": "这样啊，我，遗憾。\r\n我，有用。\r\n你，我，再来。",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/4": "你，可疑。\r\n佣兵，工作，会挑。",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/5": "魅力似乎不够……",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/6": "你，聪明，选对了！\r\n我，工作！\r\n你，相信我！",
  "message/data/event/object/udb22_231_minotaur_soldier_before_ev_talk.txt/7": "与牛头佣兵\r\n签订了契约！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_damage.txt/0": "我，快，死了！\r\n你，我，救，好！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_damage.txt/1": "我，受伤，很多！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_damage.txt/2": "我，这点，没事！\r\n你，别担心！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_darkness.txt/0": "咕嗷，嗷嗷，哞呜——！！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_find.txt/0": "我，你，追不上！\r\n你，丢下我，吃亏！",
  "choice/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/144": "\\c[4]给予疗伤草_\\c[52]剩余$tmp2_remaining\\c[2][浪费]",
  "choice/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/264": "\\c[4]给予疗伤膏_\\c[52]剩余$tmp2_remaining\\c[2][浪费]",
  "choice/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/431": "给予疗伤草_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/542": "\\c[4]给予疗伤草_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/692": "给予疗伤膏_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/804": "\\c[4]给予疗伤膏_\\c[52]剩余$tmp2_remaining\\c[2]",
  "choice/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/915": "你还好吗？",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/0": "看来现在不需要治疗。",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/1": "你没有任何治疗物品！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/2": "我，超精神。\r\n我，能打，很多。\r\n我，佣兵，干活！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/3": "我，擦伤。\r\n你，我，别担心。",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/4": "我，受伤。\r\n痛，但是，只痛。\r\n痛，还，能活。",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/5": "我，破破烂烂。\r\n佣兵，战斗，死亡，正常。\r\n你，别担心我。",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/6": "我，有兄弟。\r\n兄弟，都是，佣兵。\r\n你，见兄弟，雇。拜托。",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/7": "嘎吱嘎吱……",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/8": "哞——！\r\n我，恢复，一半！\r\n我，你，谢谢！",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/9": "咕咚咕咚……",
  "message/data/event/object/udb22_232_minotaur_soldier_after_ev_talk.txt/10": "哞——！\r\n我，恢复，全部！\r\n我，多，干活！",
  "message/data/event/object/udb22_234_beast_soldier_ev_find.txt/0": "好像在哪儿见过你……\r\n是在哪里来着。\r\n我有种不祥的预感。",
  "message/data/event/object/udb22_234_beast_soldier_ev_find.txt/1": "你……没穿衣服……？",
  "message/data/event/object/udb22_234_beast_soldier_ev_find.txt/2": "是客人吗？",
  "message/data/event/object/udb22_234_beast_soldier_ev_find.txt/3": "希望你在这里好好歇歇翅膀。",
  "message/data/event/object/udb22_234_beast_soldier_ev_find.txt/4": "先说清楚，\r\n我们很强。\r\n别打什么歪主意。",
  "message/data/event/object/udb22_234_beast_soldier_ev_talk.txt/0": "没有体毛，也不穿衣服……\r\n你不冷吗？\r\n这是某种修行法吗？",
  "message/data/event/object/udb22_234_beast_soldier_ev_talk.txt/1": "你能来到这里，真不容易，\r\n这里是兽人的国度。我们的身体\r\n有些部分和人类不同。",
  "message/data/event/object/udb22_234_beast_soldier_ev_talk.txt/2": "但我们和把人类当食物的兽人不同，\r\n是友好的邻居。只要你们不先动手。",
  "message/data/event/object/udb22_234_beast_soldier_ev_wanted.txt/0": "出现了，通缉犯！",
  "message/data/event/object/udb22_235_beast_man_ev_talk.txt/0": "咦，人类不是总该穿着衣服吗？\r\n我记错了吗？",
  "message/data/event/object/udb22_235_beast_man_ev_talk.txt/1": "哦，是人类！你是人类吧！？\r\n竟然能一路来到这种地方！",
  "message/data/event/object/udb22_235_beast_man_ev_talk.txt/2": "这里是我们兽人的国家！\r\n虽然没有人类那样的文明，\r\n但饭菜很好吃！推荐！",
  "message/data/event/object/udb22_236_beast_woman_ev_talk.txt/0": "这个国家武具不多，\r\n不过我们对食物很有自信。\r\n旅人，吃饱了再走吧！",
  "message/data/event/object/udb22_236_beast_woman_ev_talk.txt/1": "而且说不定还能遇见好人。\r\n祝你旅途上\r\n找到好同伴！",
  "message/data/event/object/udb22_237_beast_shop_ev_talk.txt/0": "兽人，不，制作，东西。\r\n我，卖，捡来的东西。\r\n你，道具，容易，得到。",
  "message/data/event/object/udb22_237_beast_shop_ev_talk.txt/1": "你，我，店，远，来。\r\n我，你，见面，好。\r\n你，店，再来，好。",
  "message/data/event/object/udb22_237_beast_shop_ev_wanted.txt/0": "哞呜呜呜！\r\n我，发现，坏人！",
  "message/data/event/object/udb22_238_beast_bird_woman_ev_talk.txt/0": "我们的国家呀，\r\n城镇很少哦～\r\n前进时要小心哦～",
  "message/data/event/object/udb22_238_beast_bird_woman_ev_talk.txt/1": "你好，你好呀——\r\n用我们的话说就是啾啾啾！",
  "message/data/event/object/udb22_238_beast_bird_woman_ev_talk.txt/2": "你能来到这里真不容易！\r\n那我就告诉你附近城镇\r\n和地下城的位置吧！",
  "message/data/event/object/udb22_238_beast_bird_woman_ev_talk.txt/3": "嗯嗯，帮上忙了吧？\r\n拜拜，再见，\r\n啾啾啾——！",
  "message/data/event/object/udb22_239_beast_bird_shop_ev_talk.txt/0": "嘿，你肚子饿了吗？\r\n这里有蔬菜、水果和浆果。\r\n怎么样？",
  "message/data/event/object/udb22_239_beast_bird_shop_ev_talk.txt/1": "我会进各种货，\r\n下次再来吧。",
  "message/data/event/object/udb22_23_cook_ev_darkness.txt/0": "不要啊啊啊啊！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/0": "……\r\n（不，我是说……你为什么不穿衣服？）",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/1": "吓我一跳，原来是你啊……\r\n怎么，想要便当吗？\r\n死了也还是要付饭钱啊……",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/2": "女王陛下，欢迎光临！\r\n如果是平民的便当，\r\n这边已经准备好了！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/3": "刚好食材用完了。\r\n不过有提前做好的一些……\r\n要买吗？",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/4": "请务必再来！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/5": "多谢惠顾！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/6": "！\r\n（不不……为什么没穿衣服？）",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/7": "僵、僵尸？！咦，是客人……吗？\r\n僵尸平时也会吃饭吗？\r\n……你不会吃我吧？",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/8": "哎呀呀，这不是女王陛下吗！\r\n想尝尝平民的饭菜吗？\r\n我一定拿出全副本事来做！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/9": "欢迎！想吃点什么？",
  "choice/data/event/object/udb22_23_cook_ev_talk.txt/2112": "元气套餐_\\c[52]$tmp1拉比斯\\c[0]（EN+$tmp2%）",
  "choice/data/event/object/udb22_23_cook_ev_talk.txt/2241": "生命套餐_\\c[52]$tmp1拉比斯\\c[0]（HP+$tmp2/EN+$tmp3%）",
  "choice/data/event/object/udb22_23_cook_ev_talk.txt/2330": "面包边_\\c[52]免费\\c[0]（EN+$tmp1%）",
  "choice/data/event/object/udb22_23_cook_ev_talk.txt/2384": "取消",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/10": "……女王陛下，实在难以启齿，\r\n但就算对象是您，\r\n也不能不收钱。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/11": "你的钱不够。\r\n我们也要做生意……抱歉了。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/12": "请交给我吧，\r\n马上为您准备！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/13": "……………………\r\n……来，请慢用！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/14": "好，我马上做。\r\n稍等一会儿！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/15": "……………………\r\n……好了，完成！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/16": "元气满满！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/17": "我们也卖便当。\r\n愿意的话，请带上一份！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/18": "我也卖便当，\r\n可以的话带一些走吧！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/19": "……女王陛下，实在难以启齿，\r\n但就算对象是您，\r\n也不能不收钱。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/20": "你的钱不够。\r\n我们也要做生意……抱歉了。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/21": "请交给我吧，\r\n马上为您准备！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/22": "……………………\r\n……来，请慢用！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/23": "好，我马上做。\r\n稍等一会儿！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/24": "……………………\r\n……好了，完成！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/25": "好吃！\r\n身体得到治疗，元气也恢复了！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/26": "我们也卖便当。\r\n愿意的话，请带上一份！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/27": "我也卖便当，\r\n可以的话买一些带走吧！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/28": "咦，面包……边？\r\n是想体验穷人的饮食，\r\n理解他们的感受吗？",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/29": "哇，能有这样了不起的君主，真是幸福。\r\n既然如此，我准备了很多，\r\n请拿去吧！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/30": "面包边啊……\r\n你还真是运气好。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/31": "正好还剩不少面包边！\r\n请…用吧！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/32": "嚼嚼嚼嚼嚼嚼嚼\r\n嚼嚼嚼嚼嚼嚼嚼\r\n嚼嚼嚼嚼嚼嚼嚼",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/33": "还挺管饱的！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/34": "呃，其实我们也卖便当……\r\n不，没什么。\r\n女王陛下，一路小心！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/35": "怎么样！吃了这么多，\r\n肚子多少也填饱了吧？",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/36": "那就再来吧！\r\n虽然你大概买不起，\r\n但我们也卖便当！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/37": "咦，面包……边？\r\n是想体验穷人的饮食，\r\n理解他们的感受吗？",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/38": "哇，能有这样了不起的君主，真是幸福。\r\n既然是这样，\r\n当然不收钱！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/39": "呃，那就来一份面包边……",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/40": "嗯，免费给你。\r\n吃完再走吧。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/41": "嚼嚼嚼嚼嚼嚼嚼",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/42": "稍微填饱了一点肚子。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/43": "呃，其实我们也卖便当……\r\n不，没什么。\r\n女王陛下，一路小心！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/44": "你……还真不容易啊。",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/45": "本来也卖便当……\r\n不过你大概买不起吧……\r\n有钱时再来吧！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/46": "这样啊……\r\n请务必再来！",
  "message/data/event/object/udb22_23_cook_ev_talk.txt/47": "是吗，随时再来啊！",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_find.txt/0": "来匹马怎么样？",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_find.txt/1": "只要有客人，\r\n我哪里都会出现！\r\n来匹马怎么样？",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/0": "对对，想取出物品时\r\n就和马交谈吧。\r\n要好好疼爱它啊！",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/1": "哦……看来你\r\n不需要马啊。",
  "choice/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/372": "购买驮马_\\c[52]$tmp1拉比斯",
  "choice/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/436": "购买驮马_\\c[52]$tmp1拉比斯",
  "choice/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/508": "不用了。",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/2": "哟，客人，驮马怎么样？\r\n也就是所谓的\\c[52]协力NPC\\c[0]。\r\n买下后，它就会跟在你身后。",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/3": "驮马可不是徒有虚名，\r\n能运\\c[52]20种\\c[0]物品！\r\n不过不能翻山越水，这是弱点。",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/4": "那么，这匹方便的驮马，\r\n现在只要\\c[52]$tmp1拉比斯\\c[0]！\r\n可没法保证前面还有别的马商！\r\n\\c[52][购买用于驮运的协力NPC]",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/5": "哎，有什么不好嘛。\r\n带着马总没坏处。",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/6": "哦，谢谢……等等，\r\n你根本没钱啊。真没劲。\r\n去赚了钱再来吧！",
  "message/data/event/object/udb22_240_beast_bird_horse_ev_talk.txt/7": "好，成交！\r\n多谢惠顾！"
}
